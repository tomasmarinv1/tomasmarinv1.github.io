{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/iea_supply_2024.csv", "format": {"type": "csv", "parse": {"share_pct": "number"}}},
  "width": 270,
  "height": 300,
  "background": "transparent",
  "padding": {"left": 5, "top": 5, "right": 10, "bottom": 5},
  "title": {
    "text": "Share of global supply of magnet rare earths, 2024.",
    "subtitle": [
      "Source: IEA (2026), chart data. Magnet rare earths only."
    ]
  },
  "config": {
    "font": "Source Serif 4",
    "view": {"stroke": null},
    "title": {
      "font": "Bricolage Grotesque",
      "fontSize": 21,
      "fontWeight": 800,
      "color": "#16212B",
      "anchor": "start",
      "subtitleFont": "Source Serif 4",
      "subtitleFontSize": 13,
      "subtitleColor": "#55616C",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Source Serif 4",
      "labelFontSize": 13,
      "labelColor": "#16212B",
      "titleFont": "Source Serif 4",
      "titleFontSize": 12,
      "titleColor": "#55616C",
      "titleFontWeight": "normal",
      "gridColor": "#D5DADE",
      "domain": false,
      "ticks": false
    },
    "legend": {
      "orient": "bottom",
      "columns": 3,
      "title": null,
      "symbolType": "square",
      "symbolSize": 120,
      "labelFont": "Source Serif 4",
      "labelFontSize": 12,
      "labelColor": "#16212B",
      "columnPadding": 10,
      "rowPadding": 4,
      "labelLimit": 0
    }
  },
  "transform": [
    {
      "calculate": "indexof(['China','Myanmar','United States','Australia','Lao PDR','Brazil','Malaysia','Viet Nam','France','Estonia','Japan','Germany','Rest of world'], datum.group)",
      "as": "ord"
    },
    {"stack": "share_pct", "groupby": ["stage"], "sort": [{"field": "ord"}], "as": ["s0", "s1"]},
    {"calculate": "(datum.s0 + datum.s1) / 2", "as": "mid"},
    {"calculate": "round(datum.share_pct) + '%'", "as": "lbl"}
  ],
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "#EEF1F2", "strokeWidth": 1, "tooltip": true, "width": {"band": 0.72}},
      "encoding": {
        "x": {
          "field": "stage",
          "type": "nominal",
          "title": null,
          "sort": ["Mining", "Refining", "Magnets"],
          "axis": {"labelAngle": 0, "labelPadding": 8}
        },
        "y": {
          "field": "s0",
          "type": "quantitative",
          "title": "Share of global supply (%)",
          "scale": {"domain": [0, 100]}
        },
        "y2": {"field": "s1"},
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": ["China", "Myanmar", "United States", "Australia", "Lao PDR", "Brazil", "Malaysia", "Viet Nam", "France", "Estonia", "Japan", "Germany", "Rest of world"],
            "range": ["#C8102E", "#2A8C82", "#1F4E9C", "#D9A441", "#E8743B", "#009739", "#10236B", "#FFD100", "#4F7FD0", "#00A3DD", "#E4A0AA", "#3A3A3A", "#CFC8BE"]
          },
          "legend": {
            "values": ["China", "Myanmar", "United States", "Australia", "Lao PDR", "Brazil", "Malaysia", "Viet Nam", "France", "Estonia", "Japan", "Germany", "Rest of world"]
          }
        },
        "order": {"field": "ord", "type": "quantitative"},
        "tooltip": [
          {"field": "stage", "type": "nominal", "title": "Stage"},
          {"field": "group", "type": "nominal", "title": "Country"},
          {"field": "share_pct", "type": "quantitative", "title": "Share (%)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.share_pct >= 9"}],
      "mark": {
        "type": "text",
        "font": "Bricolage Grotesque",
        "fontSize": 15,
        "fontWeight": 800,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {"field": "stage", "type": "nominal", "sort": ["Mining", "Refining", "Magnets"]},
        "y": {"field": "mid", "type": "quantitative"},
        "text": {"field": "lbl", "type": "nominal"}
      }
    }
  ]
}